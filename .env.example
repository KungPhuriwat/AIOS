# AI OS runtime config (.env)

# provider: fallback | openai | ollama | opencode
AIOS_LLM_PROVIDER=fallback

# shared retry/backoff attempts
AIOS_RETRY_ATTEMPTS=3

# signed audit chain secret (set strong random string in production)
AIOS_AUDIT_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1/responses

# Opencode (OpenAI-compatible chat endpoint)
OPENCODE_API_KEY=
OPENCODE_MODEL=opencode/coder
OPENCODE_ENDPOINT=https://api.opencode.ai/v1/chat/completions

# Ollama
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_ENDPOINT=http://127.0.0.1:11434/api/generate

# Discord
AIOS_DISCORD_WEBHOOK=

# LINE Messaging API
AIOS_LINE_CHANNEL_ACCESS_TOKEN=
AIOS_LINE_TO=

# Email SMTP
AIOS_EMAIL_SMTP_HOST=
AIOS_EMAIL_SMTP_PORT=587
AIOS_EMAIL_USERNAME=
AIOS_EMAIL_PASSWORD=
AIOS_EMAIL_TO=
